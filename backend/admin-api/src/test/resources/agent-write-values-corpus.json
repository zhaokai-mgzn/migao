{
  "_note": "「按值核对」口径的跨语言语料（issue #5414）。两侧各自的门禁都跑**同一份文件**：Java 侧 backend/admin-api/src/test/java/com/migao/admin/service/AgentWriteValuesTest.java；Python 侧 backend/ai-agent-service/tests/test_price_confirm_value_fact.py。任一侧改口径 ⇒ 必有一侧判红（口径漂移不再靠人记）。",
  "_vocabulary": "cases 用的字段词是 Java 侧认得的（basePrice 价格面 / status 字面面），故两侧都能直接判；python_alias_fields 声明 Python 工具参数词到这些词的等价映射（词不同、语义同）。",
  "price_field_word": "basePrice",
  "python_alias_fields": {
    "price": "basePrice",
    "before_price": "basePrice",
    "batch_id": "status"
  },
  "cases": [
    {"field": "basePrice", "given": "10.0", "current": "10.00", "expect": true,
     "_why": "按值比对：写法不同不算不符（本单的口径核心）"},
    {"field": "basePrice", "given": "10", "current": "10.000", "expect": true,
     "_why": "同上"},
    {"field": "basePrice", "given": "168.00", "current": "168", "expect": true,
     "_why": "同上"},
    {"field": "basePrice", "given": "1e3", "current": "1000", "expect": true,
     "_why": "科学计数法也是同一个价（BigDecimal/Decimal 都按值判）"},
    {"field": "basePrice", "given": "168", "current": "199", "expect": false,
     "_why": "真的不符 ⇒ 拒"},
    {"field": "basePrice", "given": "168.01", "current": "168.00", "expect": false,
     "_why": "差一分也是另一个价"},
    {"field": "basePrice", "given": "一百六十八", "current": "168", "expect": false,
     "_why": "非法数字 ⇒ fail-closed（不得当\"可比对\"放行）"},
    {"field": "basePrice", "given": " 168", "current": "168", "expect": false,
     "_why": "带空白 ⇒ 非法数字（两侧都不 trim 价格面；Java BigDecimal 抛、Python Decimal 会静默吃掉 ⇒ 必须显式挡）"},
    {"field": "basePrice", "given": "1_000", "current": "1000", "expect": false,
     "_why": "下划线同理：Python Decimal 接受、Java BigDecimal 抛 ⇒ 显式挡掉才是同口径"},
    {"field": "basePrice", "given": "Infinity", "current": "Infinity", "expect": false,
     "_why": "非有限数：Java BigDecimal 直接抛 ⇒ 两侧都必须判 false（口径不得漂移）"},
    {"field": "basePrice", "given": null, "current": "168", "expect": false,
     "_why": "一侧缺失 ⇒ fail-closed"},
    {"field": "basePrice", "given": "168", "current": null, "expect": false,
     "_why": "另一侧缺失 ⇒ fail-closed"},
    {"field": "basePrice", "given": null, "current": null, "expect": false,
     "_why": "两侧都缺 ⇒ 仍不得放行"},
    {"field": "status", "given": "on_sale", "current": "on_sale", "expect": true,
     "_why": "非价格字段：字面比对"},
    {"field": "status", "given": " on_sale ", "current": "on_sale", "expect": true,
     "_why": "非价格字段：仅 given 侧 trim（与 Java 侧逐字同口径）"},
    {"field": "status", "given": "off_sale", "current": "on_sale", "expect": false,
     "_why": "非价格字段：不符 ⇒ 拒"},
    {"field": "status", "given": "ON_SALE", "current": "on_sale", "expect": false,
     "_why": "非价格字段：大小写敏感"},
    {"field": "status", "given": null, "current": "on_sale", "expect": false,
     "_why": "非价格字段：一侧缺失 ⇒ fail-closed"}
  ]
}