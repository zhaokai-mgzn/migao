# admin-web 环境变量模板（issue #5083）
#
# 用法：复制为 `.env.local` 并按需覆盖；`.env.local` 已被 .gitignore 忽略（不入库）。
# ⚠️ 本文件只放**公共占位值** —— 任何真实密钥/口令一律走部署平台的环境变量，
#    不得写进仓库（`.env*` 由 CI `Block .env files` 门禁拦截）。
#
# ⚠️ 生产镜像**不读**这些文件：`deploy-frontend.yml` 用 `docker build --build-arg`
#    注入，`Dockerfile` 在 `npm run build` 前写成 `ENV`（缺省值兜底）；
#    单测用 `vi.stubEnv` 自带取值。故本文件仅供**本地开发**参考。

# Java admin-api 后端地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Python ai-agent-service 地址
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8001

# Cookie 域名（本地开发留空 = 用默认；跨子域部署时填 .example.com）
NEXT_PUBLIC_COOKIE_DOMAIN=

# B 端商家端 h5（手机浏览器/扫码）地址 —— 「企业设置 → 手机端入口」二维码的唯一来源（issue #5668）
# 🔴 唯一真值：**不许**在组件里硬编码域名（同族反面教材：craft-display 三份副本 #4393）。
# 留空 = 「移动端地址未配置」：此时**不画二维码**（同族判据：洗水码「缺码不画假码」）。
# 线上值 = https://app.migaozn.com/b/ （发布腿落位见 .github/workflows/bmini-h5-publish.yml）
NEXT_PUBLIC_BMINI_H5_URL=
