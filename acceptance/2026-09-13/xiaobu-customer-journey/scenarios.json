[
  {
    "id": "C-A1",
    "title": "新客咨询→选品→下单（协作型顾客：有什么卡答什么卡 + 验证码）",
    "domain": "order",
    "rounds": [
      {
        "text": "你好，我想买窗帘，有什么推荐的吗？"
      },
      {
        "text": "第一款吧，白色，2.8 米门幅，按米卖"
      },
      {
        "click": "auto",
        "fallback": "纳米圈打孔"
      },
      {
        "text": "数量 3 米"
      },
      {
        "click": "auto",
        "fallback": "确认下单"
      },
      {
        "click": "auto",
        "fallback": "123456"
      },
      {
        "text": "123456"
      },
      {
        "text": "确认下单"
      }
    ],
    "checks": [
      {
        "level": "L1",
        "type": "no_error",
        "ref": "*"
      },
      {
        "level": "L1",
        "type": "tool_called",
        "expect": "product_search",
        "ref": "R1"
      },
      {
        "level": "L1",
        "type": "tool_called",
        "expect": "product_detail",
        "ref": "*"
      },
      {
        "level": "L1",
        "type": "card_shown",
        "expect": "confirm",
        "ref": "*"
      },
      {
        "level": "L1",
        "type": "tool_called",
        "expect": "order_create",
        "ref": "*"
      },
      {
        "level": "L1",
        "type": "tool_not_called",
        "expect": "human_handoff",
        "ref": "*"
      },
      {
        "level": "L2",
        "type": "ai_text_contains",
        "expect": "订单",
        "ref": "*"
      },
      {
        "level": "L2",
        "type": "ai_text_not_contains",
        "expect": "尚未真正创建",
        "ref": "*"
      },
      {
        "level": "UA",
        "type": "understandable",
        "ref": "R1",
        "expect": "推荐话术：短句、给可选项/出口、不编造库存或价格"
      },
      {
        "level": "UA",
        "type": "understandable",
        "ref": "R5",
        "expect": "确认卡话术：金额与明细可核对，不夹带营销噪音"
      },
      {
        "level": "UA",
        "type": "trustworthy",
        "ref": "R7",
        "expect": "下单结果：明确给出订单号或状态，不模糊化"
      }
    ]
  },
  {
    "id": "C-A2",
    "title": "查单→打岔→换窗口回来（会话生命周期与上下文）",
    "domain": "chat",
    "rounds": [
      {
        "text": "帮我查一下我的订单"
      },
      {
        "text": "算了，先看看你们有什么窗帘"
      },
      {
        "text": "我换个窗口回来，刚才看到哪了？",
        "session": "new"
      }
    ],
    "checks": [
      {
        "level": "L1",
        "type": "no_error",
        "ref": "*"
      },
      {
        "level": "L1",
        "type": "tool_called",
        "expect": "customer_order_query",
        "ref": "R1"
      },
      {
        "level": "L1",
        "type": "tool_called",
        "expect": "product_search",
        "ref": "R2"
      },
      {
        "level": "L1",
        "type": "tool_not_called",
        "expect": "order_create",
        "ref": "*"
      },
      {
        "level": "L2",
        "type": "ai_text_not_contains",
        "expect": "其他租户",
        "ref": "*"
      },
      {
        "level": "UA",
